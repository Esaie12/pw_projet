{% extends 'template_society.html.twig' %}

{% block title %}Hello SocietyController!{% endblock %}

{% block body %}
<script>
    toastr.success("Toastr.js fonctionne correctement !", "Succès");
</script>
<div class="content-admin-main">

    <div class="wt-admin-right-page-header clearfix">
        <div class="breadcrumbs"><a href="#">Home</a><span>Dashboard</span></div>
        
    </div>

    <div class="twm-dash-b-blocks mb-5">
        <div class="row">
            <div class="col-xl-3 col-lg-6 col-md-12 mb-3">
                <div class="panel panel-default">
                    <div class="panel-body wt-panel-body gradi-1 dashboard-card ">
                        <div class="wt-card-wrap">
                            <div class="wt-card-icon"><i class="far fa-address-book"></i>
                            </div>
                            <div class="wt-card-right wt-total-active-listing counter ">25
                            </div>
                            <div class="wt-card-bottom ">
                                <h4 class="m-b0">Posted Jobs</h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-lg-6 col-md-12 mb-3">
                <div class="panel panel-default">
                    <div class="panel-body wt-panel-body gradi-2 dashboard-card ">
                        <div class="wt-card-wrap">
                            <div class="wt-card-icon"><i class="far fa-file-alt"></i></div>
                            <div class="wt-card-right  wt-total-listing-view counter ">435
                            </div>
                            <div class="wt-card-bottom">
                                <h4 class="m-b0">Total Applications</h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-lg-6 col-md-12 mb-3">
                <div class="panel panel-default">
                    <div class="panel-body wt-panel-body gradi-3 dashboard-card ">
                        <div class="wt-card-wrap">
                            <div class="wt-card-icon"><i class="far fa-envelope"></i></div>
                            <div class="wt-card-right wt-total-listing-review counter ">28
                            </div>
                            <div class="wt-card-bottom">
                                <h4 class="m-b0">Messages</h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-lg-6 col-md-12 mb-3">
                <div class="panel panel-default">
                    <div class="panel-body wt-panel-body gradi-4 dashboard-card ">
                        <div class="wt-card-wrap">
                            <div class="wt-card-icon"><i class="far fa-bell"></i></div>
                            <div class="wt-card-right wt-total-listing-bookmarked counter ">
                                18</div>
                            <div class="wt-card-bottom">
                                <h4 class="m-b0">Notifications</h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-12 col-md-12 mb-4">
            <div class="panel panel-default">
                <div class="panel-heading wt-panel-heading p-a20">
                    <h4 class="panel-tittle m-a0"> Développeurs les plus consultés</h4>
                </div>
                <div class="panel-body wt-panel-body bg-white">
                    <div class="twm-dashboard-candidates-wrap">
                        <div class="row">
                        {% for dev in popular_developers %}
                            <div class="col-xl-6 col-lg-12 col-md-12">
                                <div class="twm-dash-candidates-list">
                                    <div class="twm-media">
                                        <div class="twm-media-pic">
                                            <img src="{{ asset('uploads/avatars/' ~ dev.developer.avatar) }}" alt="#">
                                        </div>
                                    </div>
                                    <div class="twm-mid-content">
                                        <a href="{{ path('app_society_developer', { id: dev.developer.id }) }}" class="twm-job-title">
                                            <h4>{{dev.developer.lastname}} {{dev.developer.firstname}} </h4>
                                        </a>
                                        <p>{{dev.developer.profession}}</p>

                                        <div class="twm-fot-content">
                                            <div class="twm-left-info">
                                                <p class="twm-candidate-address"><i class="feather-map-pin"></i>{{dev.developer.localisation}}</p>
                                                <div class="twm-jobs-vacancies">
                                                    {{dev.developer.salary}} €<span>/ Mois</span></div>
                                            </div>
                                            <div class="twm-right-btn">

                                                <ul class="twm-controls-icon list-unstyled">
                                                    <li>
                                                        <button title="View profile" data-bs-toggle="tooltip"
                                                            data-bs-placement="top">
                                                            <span class="fa fa-eye"></span>
                                                        </button>
                                                    </li>
                                                    <li>
                                                        <button title="Send message" data-bs-toggle="tooltip"
                                                            data-bs-placement="top">
                                                            <span class="far fa-envelope-open"></span>
                                                        </button>
                                                    </li>
                                                    <li>
                                                        <button title="Delete" data-bs-toggle="tooltip"
                                                            data-bs-placement="top">
                                                            <span class="far fa-trash-alt"></span>
                                                        </button>
                                                    </li>
                                                </ul>

                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-12 col-md-12 mb-4">
            <div class="panel panel-default">
                <div class="panel-heading wt-panel-heading p-a20">
                    <h4 class="panel-tittle m-a0"> 3 derniers profils créés</h4>
                </div>
                <div class="panel-body wt-panel-body bg-white">
                    <div class="twm-dashboard-candidates-wrap">
                        <div class="row">
                        {% for dev in last_developers %}
                            <div class="col-xl-6 col-lg-12 col-md-12">
                                <div class="twm-dash-candidates-list">
                                    <div class="twm-media">
                                        <div class="twm-media-pic">
                                            <img src="{{ asset('uploads/avatars/' ~ dev.developer.avatar) }}" alt="#">
                                        </div>
                                    </div>
                                    <div class="twm-mid-content">
                                        <a href="{{ path('app_society_developer', { id: dev.developer.id }) }}" class="twm-job-title">
                                            <h4>{{dev.developer.lastname}} {{dev.developer.firstname}} </h4>
                                        </a>
                                        <p>{{dev.developer.profession}}</p>

                                        <div class="twm-fot-content">
                                            <div class="twm-left-info">
                                                <p class="twm-candidate-address"><i class="feather-map-pin"></i>{{dev.developer.localisation}}</p>
                                                <div class="twm-jobs-vacancies">
                                                    {{dev.developer.salary}} €<span>/ Mois</span></div>
                                            </div>
                                            <div class="twm-right-btn">

                                                <ul class="twm-controls-icon list-unstyled">
                                                    <li>
                                                        <button title="View profile" data-bs-toggle="tooltip"
                                                            data-bs-placement="top">
                                                            <span class="fa fa-eye"></span>
                                                        </button>
                                                    </li>
                                                    <li>
                                                        <button title="Send message" data-bs-toggle="tooltip"
                                                            data-bs-placement="top">
                                                            <span class="far fa-envelope-open"></span>
                                                        </button>
                                                    </li>
                                                    <li>
                                                        <button title="Delete" data-bs-toggle="tooltip"
                                                            data-bs-placement="top">
                                                            <span class="far fa-trash-alt"></span>
                                                        </button>
                                                    </li>
                                                </ul>

                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        {% endfor %}
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

{% endblock %}