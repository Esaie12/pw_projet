{% extends 'base.html.twig' %}

{% block title %}Log in!{% endblock %}

{% block body %}
 <div class="page-content">

        

            <!-- Login Section Start -->
            <div class="section-full site-bg-white">
                
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-xl-8 col-lg-6 col-md-5 twm-log-reg-media-wrap">
                            <div class="twm-log-reg-media">
                                <div class="twm-l-media">
                                    <img src="{{asset('images/login-bg.png')}}" alt="">
                                </div>
                            </div>
                        </div>
                        <div class="col-xl-4 col-lg-6 col-md-7">
                            <div class="twm-log-reg-form-wrap">
                                <div class="twm-log-reg-logo-head">
                                    <a href="index-2.html">
                                        <img src="{{asset('images/logo-dark.png')}}" alt="" class="logo">
                                    </a> 
                                </div>
                                <div class="twm-log-reg-inner">
                                    <div class="twm-log-reg-head">
                                        <div class="twm-log-reg-logo">
                                            <span class="log-reg-form-title">S'inscrire</span>
                                        </div>
                                    </div>
                                    <div class="twm-tabs-style-2">
                                        
                                        <ul class="nav nav-tabs" id="myTab2" role="tablist">

                                            <!--Login Candidate-->  
                                            <li class="nav-item">
                                                <a  href="{{ path('app_user_new') }}" class="nav-link "><i class="fas fa-user-tie"></i>Developpeur</a>
                                            </li>
                                            <!--Login Employer-->
                                            <li class="nav-item">
                                                <a href="{{ path('app_user_new_society') }}" class="nav-link  active" ><i class="fas fa-building"></i>Société</a>
                                            </li>
                                        
                                        </ul>
                                        
                                        <div class="tab-content" id="myTab2Content">
                                            <!--Login Candidate Content-->  
                                            <div class="tab-pane fade show active" id="twm-login-candidate">
                                               
                                               {{ form_start(form, {'attr': {'class': 'form-container'}}) }}
                                                    <div class="row">

                                                        <div class="col-lg-12">
                                                            <div class="form-group mb-3">
                                                                {{ form_widget(form.name_society, {'attr': {'class': 'form-control', 'placeholder': "Nom de la société*"}}) }}
                                                                {{ form_errors(form.name_society) }}
                                                            </div>
                                                        </div>
                                                        <!-- Email -->
                                                        <div class="col-lg-12">
                                                            <div class="form-group mb-3">
                                                                {{ form_widget(form.email, {'attr': {'class': 'form-control', 'placeholder': 'Adresse e-mail*'}}) }}
                                                                {{ form_errors(form.email) }}
                                                            </div>
                                                        </div>

                                                        <!-- Password -->
                                                        <div class="col-lg-12">
                                                            <div class="form-group mb-3">
                                                                {{ form_widget(form.password, {'attr': {'class': 'form-control', 'placeholder': 'Mot de passe*'}}) }}
                                                                {{ form_errors(form.password) }}
                                                            </div>
                                                        </div>

                                                        <!-- Type d'utilisateur -->
                                                        <div class="col-lg-12">
                                                            <div class="form-group mb-3">
                                                                {{ form_widget(form.type_user, {'attr': {'class': 'form-control', 'value': 'society'}}) }}
                                                                {{ form_errors(form.type_user) }}
                                                            </div>
                                                        </div>

                                                        <!-- Submit Button -->
                                                        <div class="col-md-12">
                                                            <div class="form-group">
                                                                {{ form_widget(form.submit, {'attr': {'class': 'site-button'}}) }}
                                                            </div>
                                                        </div>

                                                    </div>
                                                {{ form_end(form) }}


                                            </div>

                                            <!--Login Employer Content--> 
                                            <div class="tab-pane fade" id="twm-login-Employer">
                                                <div class="row">

                                                    <div class="col-lg-12">
                                                        <div class="form-group mb-3">
                                                            <input name="username" type="text" required="" class="form-control" placeholder="Usearname*">
                                                        </div>
                                                    </div>
                                                    
                                                    <div class="col-lg-12">
                                                        <div class="form-group mb-3">
                                                            <input name="email" type="text" class="form-control" required="" placeholder="Password*">
                                                        </div>
                                                    </div>
                                                    
                                                    <div class="col-lg-12">
                                                        <div class="twm-forgot-wrap">
                                                            <div class="form-group mb-3">
                                                                <div class="form-check">
                                                                    <input type="checkbox" class="form-check-input" id="Password4">
                                                                    <label class="form-check-label rem-forgot" for="Password4">Remember me <a href="javascript:;" class="site-text-primary">Forgot Password</a></label>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <div class="col-md-12">
                                                        <div class="form-group">
                                                            <button type="submit" class="site-button">Log in</button>
                                                        </div>
                                                    </div>

                                                    <div class="col-md-12">
                                                        <div class="form-group">
                                                            <span class="center-text-or">Or</span>
                                                        </div>
                                                    </div>

                                                    <div class="col-md-12">
                                                        <div class="form-group">
                                                            <button type="submit" class="log_with_facebook">
                                                                <i class="fab fa-facebook"></i>
                                                                Continue with Facebook
                                                            </button>
                                                        </div>
                                                    </div>

                                                    <div class="col-md-12">
                                                        <div class="form-group">
                                                            <button type="submit" class="log_with_google">
                                                                <img src="images/google-icon.png" alt="">
                                                                Continue with Google
                                                            </button>
                                                        </div>
                                                    </div>
                                                    
                                                    
                                                </div>
                                            </div>
                                        
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div> 
     
        </div>
{% endblock %}
