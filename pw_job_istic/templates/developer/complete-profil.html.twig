
{% extends 'template.html.twig' %}

{% block body %}
 <div class="page-content">

            <!-- INNER PAGE BANNER -->
            <div class="wt-bnr-inr overlay-wraper bg-center" style="background-image:url({{asset('images/banner/1.jpg')}});">
                <div class="overlay-main site-bg-white opacity-01"></div>
                <div class="container">
                    <div class="wt-bnr-inr-entry">
                        <div class="banner-title-outer">
                            <div class="banner-title-name">
                                <h2 class="wt-title">Candidate Profile</h2>
                            </div>
                        </div>
                        <!-- BREADCRUMB ROW -->                            
                        
                            <div>
                                <ul class="wt-breadcrumb breadcrumb-style-2">
                                    <li><a href="index-2.html">Home</a></li>
                                    <li>Candidate Profile</li>
                                </ul>
                            </div>
                        
                        <!-- BREADCRUMB ROW END -->                        
                    </div>
                </div>
            </div>
            <!-- INNER PAGE BANNER END -->


            <!-- OUR BLOG START -->
            <div class="section-full p-t120  p-b90 site-bg-white">
                

                <div class="container">
                    <div class="row">
                        
                        <div class="col-xl-3 col-lg-4 col-md-12 rightSidebar m-b30">

                            {{include('includes/sidebars/developer.html.twig')}}

                        </div>

                        <div class="col-xl-9 col-lg-8 col-md-12 m-b30">
                            <!--Filter Short By-->
                            <div class="twm-right-section-panel site-bg-gray">
                                {{ form_start(form, {'action': path('app_dev_complete_profil'), 'method': 'POST', 'attr': {'class': 'form-horizontal'}}) }}
                                    
                
                                    <!--Basic Information-->
                                    <div class="panel panel-default">
                                        <div class="panel-heading wt-panel-heading p-a20">
                                            <h4 class="panel-tittle m-a0">Basic Informations</h4>
                                        </div>
                                        


                                        <div class="panel-body wt-panel-body p-a20 m-b30 ">
                                            
                                            <div class="row">
                                                               
                                                {% if app.user.isActive() == false %}
                                                <div class="col-lg-12">
                                                    <div class="alert alert-danger text-center" role="alert">
                                                        Votre compte est inactif, veuillez completer vos informations. Afin d'accéder aux fonctionnalités
                                                    </div>
                                                </div>
                                                {% endif %}
                                            </div>

                                            <div class="row">
                                            
                                            
                                            <div class="col-xl-6 col-lg-6 col-md-12">
                                                <div class="form-group">
                                                    <label>Nom</label>
                                                    <div class="ls-inputicon-box"> 
                                                        {{ form_widget(form.firstname, {'attr': {'class': 'form-control', 'placeholder': 'Devid Smith'}}) }}
                                                        <i class="fs-input-icon fa fa-user "></i>
                                                    </div>
                                                </div>
                                            </div>
                                            
                                            <div class="col-xl-6 col-lg-6 col-md-12">
                                                <div class="form-group">
                                                    <label>Prénoms</label>
                                                    <div class="ls-inputicon-box"> 
                                                        {{ form_widget(form.lastname, {'attr': {'class': 'form-control', 'placeholder': 'John Doe'}}) }}
                                                        <i class="fs-input-icon fa fa-user "></i>
                                                    </div>
                                                </div>
                                            </div>
                                            
                                            <div class="col-xl-6 col-lg-6 col-md-12">
                                                <div class="form-group">
                                                    <label>À propos de vous</label>
                                                    <div class="ls-inputicon-box"> 
                                                        {{ form_widget(form.aboutMe, {'attr': {'class': 'form-control', 'placeholder': 'Décrivez-vous'}}) }}
                                                        <i class="fs-input-icon fas fa-info-circle"></i>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-xl-6 col-lg-6 col-md-12">
                                                <div class="form-group">
                                                    <label>Localisation</label>
                                                    <div class="ls-inputicon-box"> 
                                                        {{ form_widget(form.localisation, {'attr': {'class': 'form-control', 'placeholder': 'Ex. Paris, France'}}) }}
                                                        <i class="fs-input-icon fa fa-map-marker-alt"></i>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-xl-6 col-lg-6 col-md-12">
                                                <div class="form-group">
                                                    <label>Salaire minimum</label>
                                                    <div class="ls-inputicon-box"> 
                                                        {{ form_widget(form.salary, {'attr': {'class': 'form-control', 'placeholder': 'Ex. 3000€'}}) }}
                                                        <i class="fs-input-icon fa fa-euro-sign"></i>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-xl-6 col-lg-6 col-md-12">
                                                <div class="form-group">
                                                    <label>Niveau d'expérience</label>
                                                    <div class="ls-inputicon-box"> 
                                                        {{ form_widget(form.niveau_experience, {'attr': {'class': 'form-control'}}) }}
                                                        <i class="fs-input-icon fa fa-briefcase"></i>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-xl-6 col-lg-6 col-md-12">
                                                <div class="form-group">
                                                    <label>Avatar</label>
                                                    <div class="ls-inputicon-box"> 
                                                        {{ form_widget(form.avatar, {'attr': {'class': 'form-control'}}) }}
                                                        <i class="fs-input-icon fa fa-image"></i>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-lg-12 col-md-12">                                   
                                                <div class="text-left">
                                                    {{ form_widget(form.submit, {'attr': {'class': 'site-button'}}) }}
                                                </div>
                                            </div>

                                            
                                            {{ form_end(form) }}
                                        </div>

                                                    
                                        </div>
                                    </div>
                
                                {{ form_end(form) }}
                            </div>
                        </div>

                    </div>
                </div>
            </div>   
            <!-- OUR BLOG END -->
          
            
     
        </div>
{% endblock %}