{% extends 'template_society.html.twig' %}

{% block title %}Hello SocietyController!{% endblock %}

{% block body %}

<div class="content-admin-main">

    <div class="wt-admin-right-page-header clearfix">
        <h2>My Profile</h2>
        <div class="breadcrumbs"><a href="#">Home</a><a href="#">Dasboard</a><span>Profile</span></div>
    </div>

    {{ form_start(form, { 'attr': { 'class': 'form-horizontal' } }) }}
        <div class="panel panel-default">
            <div class="panel-heading wt-panel-heading p-a20">
                <h4 class="panel-tittle m-a0">Update Profile Image</h4>
            </div>
            <div class="panel-body wt-panel-body p-a20 m-b30 bg-white">

                <div class="dashboard-profile-section clearfix">
                    <div class="dashboard-profile-pic">
                        <div class="dashboard-profile-photo">
                            <img src="images/user-avtar/pic4.jpg" alt="">
                            <div class="upload-btn-wrapper">
                                <div id="upload-image-grid"></div>
                                <button class="site-button button-sm">Upload Photo</button>
                                {{ form_widget(form.avatar, {
                                    'attr': {
                                        'class': 'form-control',
                                        'id': 'file-uploader',
                                        'accept': '.jpg, .jpeg, .png'
                                    }
                                }) }}
                            </div>
                        </div>
                    </div>

                </div>

            </div>
        </div>

        <!--Basic Information-->
        <div class="panel panel-default">
            <div class="panel-heading wt-panel-heading p-a20">
                <h4 class="panel-tittle m-a0">Basic Informations</h4>
            </div>
            <div class="panel-body wt-panel-body p-a20 m-b30 ">

                <div class="row">

                    <div class="col-xl-4 col-lg-6 col-md-12">
                        <div class="form-group">
                            <label>Nom de la société</label>
                            <div class="ls-inputicon-box">
                                {{ form_widget(form.name, {'attr': {'class': 'form-control', 'placeholder': 'Nom de la société'}}) }}
                                <i class="fs-input-icon fa fa-user "></i>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-4 col-lg-6 col-md-12">
                        <div class="form-group">
                            <label>Phone</label>
                            <div class="ls-inputicon-box">
                                {{ form_widget(form.telephone, {'attr': {'class': 'form-control', 'placeholder': '+33 XXXXXXXXX'}}) }}
                                <i class="fs-input-icon fa fa-phone-alt"></i>
                            </div>
                        </div>
                    </div>


                    <div class="col-xl-4 col-lg-6 col-md-12">
                        <div class="form-group">
                            <label>Website</label>
                            <div class="ls-inputicon-box">
                               {{ form_widget(form.website, {'attr': {'class': 'form-control', 'placeholder': 'Site web'}}) }}
                                <i class="fs-input-icon fa fa-globe-americas"></i>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-4 col-lg-6 col-md-12">
                        <div class="form-group">
                            <label>Localisation</label>
                            <div class="ls-inputicon-box">
                                {{ form_widget(form.localisation, {'attr': {'class': 'form-control', 'placeholder': 'Nom de la société'}}) }}
                                <i class="fs-input-icon fa fa-address-card"></i>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-4 col-lg-6 col-md-12">
                        <div class="form-group">
                            <label>Siret</label>
                            <div class="ls-inputicon-box">
                                {{ form_widget(form.siret, {'attr': {'class': 'form-control', 'placeholder': 'Siret'}}) }}
                                <i class="fs-input-icon fa fa-address-card"></i>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-4 col-lg-6 col-md-12">
                        <div class="form-group">
                            <label>Année de création</label>
                            <div class="ls-inputicon-box">
                                {{ form_widget(form.creation_annee, {'attr': {'class': 'form-control', 'placeholder': 'Année de création'}}) }}
                                <i class="fs-input-icon fa fa-user-graduate"></i>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-12">
                        <div class="form-group">
                            <label>Description</label>
                            {{ form_widget(form.about, {'attr': {'class': 'form-control', 'placeholder': 'Dites un peu sur vous'}}) }}
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-6">
                                    <div class="form-group">
                                        <label>Facebook</label>
                                        <div class="ls-inputicon-box"> 
                                            {{ form_widget(form.facebook, {'attr': {'class': 'form-control', 'placeholder': '"https://www.facebook.com/'}}) }}
                                            <i class="fs-input-icon fab fa-facebook-f"></i>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-4 col-md-6">    
                                    <div class="form-group">
                                        <label>linkedin</label>
                                        <div class="ls-inputicon-box"> 
                                            {{ form_widget(form.linkedin, {'attr': {'class': 'form-control', 'placeholder': 'https://in.linkedin.com/'}}) }}
                                            <i class="fs-input-icon fab fa-linkedin-in"></i>
                                        </div>
                                    </div>
                                </div>
                                
                    <div class="col-lg-12 col-md-12">
                        <div class="text-left">
                             {{ form_widget(form.submit, {'attr': {'class': 'site-button'}}) }}
                        </div>
                    </div>


                </div>

            </div>
        </div>

    {{ form_end(form) }}


</div>

{% endblock %}