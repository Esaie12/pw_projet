{% extends 'template.html.twig' %}


{% block title %}Hello DeveloperController!{% endblock %}

{% block body %}
<div class="page-content">



    <!-- OUR BLOG START -->
    <div class="section-full p-t120  p-b90 site-bg-white">

                <div class="bg-center" style="display: flex; justify-content: center;">
                    <ul class="wt-breadcrumb breadcrumb-style-2">
                        <li>Nos Offres</li>
                    </ul>
                </div><br/><br/><br/>

        <div class="container">
            <div class="row">

                <div class="col-lg-4 col-md-12 rightSidebar">

                    <div class="side-bar">

                        <div class="sidebar-elements search-bx">

                            {{ form_start(filterForm, { 'attr': { 'class': 'form-horizontal' },  'action': path('app_jobs')  }) }}

                                <div class="form-group mb-4">
                                    <h4 class="section-head-small mb-4">Langages</h4>
                                    {{ form_widget(filterForm.technologies, {
                                        'attr': {
                                            'class': 'wt-search-bar-select selectpicker',
                                            'data-live-search': 'true',
                                            'id': 'technologies-select',
                                        }
                                    }) }}
                                </div>

                                <div class="form-group mb-4">
                                    <h4 class="section-head-small mb-4">Titre</h4>
                                    <div class="input-group">
                                        {{ form_widget(filterForm.title, {'attr': {'class': 'form-control', 'placeholder': ""}}) }}
                                        <button class="btn" type="button"><i class="feather-search"></i></button>
                                    </div>
                                </div>

                                <div class="form-group mb-4">
                                    <h4 class="section-head-small mb-4">Location</h4>
                                    <div class="input-group">
                                        {{ form_widget(filterForm.location, {'attr': {'class': 'form-control', 'placeholder': ""}}) }}
                                        <button class="btn" type="button"><i class="feather-map-pin"></i></button>
                                    </div>
                                </div>

                                <div class="twm-sidebar-ele-filter">
                                    <h4 class="section-head-small mb-4">Niveau</h4>
                                    <ul>
                                        {% for choice in filterForm.experienceLevel %}
                                        <li>
                                            <div class="form-check">
                                                {{ form_widget(choice, { 
                                                    'attr': {'class': 'form-check-input'} 
                                                }) }}
                                                {{ form_label(choice, null, { 
                                                    'label_attr': {'class': 'form-check-label'} 
                                                }) }}
                                            </div>
                                        </li>
                                        {% endfor %}
                                    </ul>
                                </div>

                            {{ form_end(filterForm) }}

                        </div>


                    </div>

                    <div class="twm-advertisment" style="background-image:url(images/add-bg.jpg);">
                        <div class="overlay"></div>
                        <h4 class="twm-title">Recrutement?</h4>
                        <p>Recevez les offres d’emploi les plus adaptées directement par e-mail.
                           <br/>Ajoutez votre CV MAINTENANT !</p>
                        <a href="#" class="site-button white">En savoir plus</a>
                    </div>

                </div>

                <div class="col-lg-8 col-md-12">
                    <!--Filter Short By-->
                    <div class="product-filter-wrap d-flex justify-content-between align-items-center m-b30">
                        <span class="woocommerce-result-count-left">
                        <span style="color: blue; font-weight: bold;">{{nbOffre}}</span>
                        Offres Postees
                        </span>

                    </div>

                    <div class="twm-jobs-list-wrap">
                        <ul>
                            {% for job in jobs %}
                            <li>
                                <div class="twm-jobs-list-style1 mb-5">
                                    <div class="twm-media">
                                        <img src="{{ asset('uploads/avatars/' ~ job.image) }}" alt="#">
                                    </div>
                                    <div class="twm-mid-content">
                                        <a href="job-detail.html" class="twm-job-title">
                                            <h4>{{job.title}}<span class="twm-job-post-duration">/ publie le {{ job.publishedAt|date('d-m-Y') }}</span></h4>
                                        </a>
                                        <p class="twm-job-address">{{ job.location }}</p>
                                        <a href="https://themeforest.net/user/thewebmax/portfolio"
                                            class="twm-job-websites site-text-primary">{{ job.society.website}}</a>
                                            <p style="margin-top:5px" class="twm-candidate-address">Vu par <i class="fa fa-eye"></i>{{ job.getViewsCount() }}</p>
                                    </div>
                                    <div class="twm-right-content">
                                        <div class="twm-jobs-category green"><span class="twm-bg-green">Nouveau</span></div>
                                        <div class="twm-jobs-amount">{{ job.salary}} €<span>/ Mois</span>
                                    </div>
                                        {% if is_granted('ROLE_DEV') %}
                                        <a href="{{path('dev_job_details',{id:job.id})}}" class="twm-jobs-browse site-text-primary">Voir Job</a>
                                        {% else %}
                                        <a href="{{path('app_login')}}" class="twm-jobs-browse site-text-danger">Me connecter</a>
                                        {% endif %}
                                    </div>
                                </div>
                            </li>
                            {% else %}
                            <li>Aucune offre trouvée.</li>
                            {% endfor %}
                        </ul>
                    </div>

                    <div class="pagination-outer">
                        <div class="pagination-style1">
                            <div class="pagination">
                                {{ knp_pagination_render(jobs) }}
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
    <!-- OUR BLOG END -->

</div>
{% endblock %}