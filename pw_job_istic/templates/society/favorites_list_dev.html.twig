{% extends 'template_society.html.twig' %}

{% block title %}Hello SocietyController!{% endblock %}

{% block body %}
<div class="content-admin-main">

    <div class="wt-admin-right-page-header clearfix">
        <div class="breadcrumbs"><a href="#">Home</a><span>Dasboard</span></div>
    </div>

    <div class="twm-dash-b-blocks mb-5">
        <div class="row">
            <div class="col-lg-12">
                {% if developers is empty %}
        <p>Vous n'avez aucun développeur dans vos favoris pour le moment.</p>
    {% else %}
        <table class="table">
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Email</th>
                    <th>Localisation</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for developer in developers %}
                    <tr>
                        <td>{{ developer.firstname }} {{ developer.lastname }}</td>
                        <td>{{ developer.user.email }}</td>
                        <td>{{ developer.localisation }}</td>
                        <td>
                            <a href="{{ path('app_society_developer_show', { id: developer.id }) }}" class="btn btn-info btn-sm">Voir Profil</a>
                            <form action="{{ path('society_remove_favorite', { id: developer.id }) }}" method="post" style="display: inline;">
                                <button type="submit" class="btn btn-danger btn-sm">Retirer des favoris</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
            </div>
        </div>
    </div>
{% endblock %}