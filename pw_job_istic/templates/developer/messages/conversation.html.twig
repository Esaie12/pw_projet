
{% extends 'template.html.twig' %}

{% block body %}
<div class="section-full p-t120  p-b90 site-bg-white">
                <div class="container">
                    <div class="row">
                        
                        <div class="col-xl-3 col-lg-4 col-md-12 rightSidebar m-b30">

                             {{include('includes/sidebars/developer.html.twig', { active: active_tab }) }} 
                        </div>

                        <div class="col-xl-9 col-lg-8 col-md-12 m-b30">
                            <!--Filter Short By-->
                            <div class="twm-right-section-panel site-bg-gray">
                                <div class="wt-admin-dashboard-msg-2  twm-dashboard-style-2">
                                    <!--Left Msg section-->
                                    <div class="wt-dashboard-msg-user-list">
                                        
                                        <div class="wt-dashboard-msg-search">
                                            <div class="input-group">
                                                <input class="form-control" placeholder="Rechercher un message" type="text">
                                                <button class="btn" type="button"><i class="fa fa-search"></i></button>
                                            </div>
                                        </div>
                                        <!-- Search Section End-->
                                        
                                        
                                        <!-- user msg list start-->
                                        <div id="msg-list-wrap" class="wt-dashboard-msg-search-list scrollbar-macosx">
                                            {% for user in users %}
                                            <div class="wt-dashboard-msg-search-list-wrap">
                                                <a href="{{ path('app_message_user', {id: user.id}) }}" class="msg-user-info clearfix">
                                                    <div class="msg-user-timing">
                                                        {% if user.typeUser == "society" %}
                                                            Société
                                                        {% else %}
                                                            Développeur
                                                        {% endif %}
                                                    </div>
                                                    <div class="msg-user-info-pic">
                                                        {% if user.typeUser == "society" %}
                                                                <img src="{{ asset('uploads/avatars/' ~ user.society.avatar) }}" alt="">
                                                        {% else %}
                                                            <img src="{{ asset('uploads/avatars/' ~ user.developer.avatar) }}" alt="">
                                                        {% endif %}
                                                    </div>
                                                    <div class="msg-user-info-text">
                                                        <div class="msg-user-name">
                                                            {% if user.typeUser == "society" %}
                                                            {{ user.society.name }}
                                                            {% else %}
                                                            {{ user.developer.firstname }} {{ user.developer.lastname }}
                                                            {% endif %}
                                                        </div>
                                                        <div class="msg-user-discription">{{ user.email }}</div>
                                                    </div>
                                                </a>
                                            </div>
                                            {% endfor %}                                             
                                        </div>
                                        <!-- user msg list End-->
                                        
                                    </div>
                                    
                                    <!--Right Msg section-->
                                    <div class="wt-dashboard-msg-box">
                                        <div class="single-msg-user-name-box">
                                            <div class="single-msg-short-discription">
                                                <h4 class="single-msg-user-name">
                                                    {% if targetUser.typeUser == "society" %}
                                                    {{ targetUser.society.name }}
                                                    {% else %}
                                                    {{ targetUser.developer.firstname }} {{ targetUser.developer.lastname }}
                                                    {% endif %}
                                                </h4>
                                               {{ targetUser.email }}
                                            </div>
                                            <a href="#" class="message-action"><i class="far fa-trash-alt"></i> Effacer la  Conversation</a>
                                        </div>
                                        <div id="msg-chat-wrap" class="single-user-msg-conversation scrollbar-macosx">
                                        {% for message in messages %}
                                            {% if message.senderId != app.user.id %}
                                            <div class="single-user-comment-wrap">
                                                <div class="row">
                                                    <div class="col-xl-9 col-lg-12">
                                                        <div class="single-user-comment-block clearfix">
                                                            <div class="single-user-com-pic">
                                                                <img src="{{ asset('uploads/avatars/' ~ app.user.developer.avatar) }}" alt="">
                                                            </div>
                                                            <div class="single-user-com-text">{{ message.content }}</div>
                                                            <div class="single-user-msg-time">{{ message.createdAt |date('d/m/Y') }}</div>
                                                        </div>
                                                    </div>
                                                
                                                </div>
                                            </div>
                                            {% else %}
                                            
                                            <div class="single-user-comment-wrap sigle-user-reply">
                                                <div class="row justify-content-end">
                                                    <div class="col-xl-9 col-lg-12">
                                                        <div class="single-user-comment-block clearfix">
                                                            <div class="single-user-com-pic"><img src="{{ asset('uploads/avatars/' ~ app.user.developer.avatar) }}" alt=""></div>
                                                            <div class="single-user-com-text">{{ message.content }}</div>
                                                            <div class="single-user-msg-time">{{ message.createdAt |date('d/m/Y') }}</div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div> 
                                            {% endif %}

                                        {% endfor %}
                                        </div>
                                        <form method="POST" class="single-msg-reply-comment">
                                            <div class="input-group">
                                                <textarea name="message" required class="form-control" placeholder="Entrer un message"></textarea>
                                                <button class="btn" type="submit"><i class="fa fa-paper-plane"></i></button>
                                            </div>
                                        </form>
                                    </div>
                                
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>  
{% endblock %}