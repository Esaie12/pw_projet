{% extends 'template.html.twig' %}


{% block title %}Hello DeveloperController!{% endblock %}

{% block body %}
<!-- INNER PAGE BANNER -->
<div class="wt-bnr-inr overlay-wraper bg-center"
    style="background-image:url({{ asset('images/banner/1.jpg') }});">
    <div class="overlay-main site-bg-white opacity-01"></div>
    <div class="container">
        <div class="wt-bnr-inr-entry">
            <div class="banner-title-outer">
                <div class="banner-title-name">
                    <h2 class="wt-title">{{ job.title }}</h2>
                </div>
            </div>
            <!-- BREADCRUMB ROW -->

            <div>
                <ul class="wt-breadcrumb breadcrumb-style-2">
                    <li><a href="index-2.html">Home</a></li>
                    <li>{{ job.title }}</li>
                </ul>
            </div>

            <!-- BREADCRUMB ROW END -->
        </div>
    </div>
</div>
<!-- INNER PAGE BANNER END -->



<!-- OUR BLOG START -->
<div class="section-full  p-t120 p-b90 bg-white">
    <div class="container">

        <!-- BLOG SECTION START -->
        <div class="section-content">
            <div class="row d-flex justify-content-center">

                <div class="col-lg-8 col-md-12">
                    <!-- Candidate detail START -->
                    <div class="cabdidate-de-info">
                        <div class="twm-job-self-wrap">
                            <div class="twm-job-self-info">
                                <div class="twm-job-self-top">
                                    <div class="twm-media-bg">
                                        <img src="images/job-detail-bg.jpg" alt="#">
                                        <div class="twm-jobs-category green"><span class="twm-bg-green">New</span></div>
                                    </div>


                                    <div class="twm-mid-content">

                                        <div class="twm-media">
                                            <img src="{{ asset('uploads/avatars/' ~ job.image) }}" alt="#">
                                        </div>

                                        <h4 class="twm-job-title">{{job.title}} <span
                                                class="twm-job-post-duration">/ 1 days ago</span></h4>
                                        <p class="twm-job-address"><i class="feather-map-pin"></i> {{job.location}}</p>

                                        <div class="twm-job-self-mid">
                                            <div class="twm-job-self-mid-left">
                                                <a href="https://themeforest.net/user/thewebmax/portfolio"
                                                    class="twm-job-websites site-text-primary">https://thewebmax.com</a>
                                                <div class="twm-jobs-amount">{{job.salary}}£ <span>/ Mois</span></div>
                                            </div>
                                            
                                        </div>

                                        <div class="twm-job-self-bottom">
                                            {% if candidature_bool %}
                                            <p>
                                                <strong>Statut :</strong>
                                                <span style="color: {{candidature.status.color}} ">{{candidature.status.name}}</span>
                                            </p> <br>
                                            {% else %}
                                            <!-- Remetre ici le btn postuler -->
                                            <a class="site-button" data-bs-toggle="modal" href="#apply_job_popup"
                                                role="button">
                                                Postuler à l'offre
                                            </a>
                                            {% endif %}

                                            {% if job in app.user.developer.favoriteJobs %}
                                                <form style="margin-top :8px" action="{{ path('dev_job_favorite_remove', { id: job.id }) }}" method="post">
                                                    <button type="submit" class="btn btn-danger">Retirer des favoris</button>
                                                </form>
                                            {% else %}
                                                <form style="margin-top :8px" action="{{ path('dev_job_favorite_add', { id: job.id }) }}" method="post">
                                                    <button type="submit" class="btn btn-primary">Ajouter aux favoris</button>
                                                </form>
                                            {% endif %}

                                            <div class="twm-job-apllication-area"> Fin de l'offre:
                                                <span class="twm-job-apllication-date ">{{ job.publishedAt|date('d/m/Y') }}</span>
                                            </div>
                                           
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>

                        <h4 class="twm-s-title">Description de l'offre:</h4>

                        <p>{{job.description}}
                        
                        <h4 class="twm-s-title">Responsabilities:</h4>
                        <ul class="description-list-2">
                            <li>
                                <i class="feather-check"></i>
                                 Accurately estimate design tickets during planning sessions
                            </li>
                            <li>
                                <i class="feather-check"></i>
                                Accurately estimate design tickets during planning sessions.
                            </li>
                            <li>
                                <i class="feather-check"></i>
                                Partnering with product and engineering to translate business and user goals into
                                elegant and practical designs. that can deliver on key business and user metrics.
                            </li>
                            <li>
                                <i class="feather-check"></i>
                                Create wireframes, storyboards, user flows, process flows and site maps to communicate
                                interaction and design.
                            </li>
                            <li>
                                <i class="feather-check"></i>
                                Present and defend designs and key deliverables to peers and executive level
                                stakeholders.
                            </li>
                            <li>
                                <i class="feather-check"></i>
                                Execute all visual design stages from concept to final hand-off to engineering.
                            </li>

                        </ul>

                        

                        <h4 class="twm-s-title">Location</h4>
                        <div class="twm-m-map mb-5">
                            <div class="twm-m-map-iframe">
                                <iframe height="310"
                                    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3304.8534521658976!2d-118.2533646842856!3d34.073270780600225!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x80c2c6fd9829c6f3%3A0x6ecd11bcf4b0c23a!2s1363%20Sunset%20Blvd%2C%20Los%20Angeles%2C%20CA%2090026%2C%20USA!5e0!3m2!1sen!2sin!4v1620815366832!5m2!1sen!2sin"></iframe>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4 col-md-12 rightSidebar">

                    <div class="side-bar mb-4">
                        <div class="twm-s-info2-wrap mb-5">
                            <div class="twm-s-info2">
                                <h4 class="section-head-small mb-4">Information</h4>
                                <ul class="twm-job-hilites">
                                    <li>
                                        <i class="fas fa-eye"></i>
                                        <span class="twm-title">{{ job.getViewsCount() }} Vues</span>
                                    </li>
                                    <li>
                                        <i class="fas fa-file-signature"></i>
                                        <span class="twm-title">0 Candidatures</span>
                                    </li>
                                </ul>
                                <ul class="twm-job-hilites2">
                                    <li>
                                        <div class="twm-s-info-inner">
                                            <i class="fas fa-map-marker-alt"></i>
                                            <span class="twm-title">Location</span>
                                            <div class="twm-s-info-discription">{{job.location}}</div>
                                        </div>
                                    </li>
                                    <li>
                                        <div class="twm-s-info-inner">
                                            <i class="fas fa-user-tie"></i>
                                            <span class="twm-title">Titre</span>
                                            <div class="twm-s-info-discription">{{job.title}}</div>
                                        </div>
                                    </li>
                                    <li>
                                        <div class="twm-s-info-inner">
                                            <i class="fas fa-clock"></i>
                                            <span class="twm-title">Experience</span>
                                            <div class="twm-s-info-discription">{{job.experienceLevel}}</div>
                                        </div>
                                    </li>
                                    
                                    <li>
                                        <div class="twm-s-info-inner">

                                            <i class="fas fa-money-bill-wave"></i>
                                            <span class="twm-title">Salaire </span>
                                            <div class="twm-s-info-discription">{{job.salary}} € / Mois</div>
                                        </div>
                                    </li>

                                </ul>

                            </div>
                        </div>

                        <div class="widget tw-sidebar-tags-wrap">
                            <h4 class="section-head-small mb-4">Technologies</h4>

                            <div class="tagcloud">
                                {% for technology in job.technologies %}
                                <a href="javascript:void(0)">{{ technology.name }}</a>
                                {% endfor %}
                            </div>
                        </div>

                    </div>

                    <div class="twm-s-info3-wrap mb-5">
                        <div class="twm-s-info3">
                            <div class="twm-s-info-logo-section">
                                <div class="twm-media">
                                    <img src="{{ asset('uploads/avatars/' ~ job.society.avatar) }}" alt="#">
                                </div>
                                <h4 class="twm-title">{{job.title}}</h4>
                            </div>
                            <ul>

                                <li>
                                    <div class="twm-s-info-inner">
                                        <i class="fas fa-building"></i>
                                        <span class="twm-title">{{job.society.name}}</span>
                                        <div class="twm-s-info-discription">Entreprise informatique</div>
                                    </div>
                                </li>
                                <li>
                                    <div class="twm-s-info-inner">
                                        <i class="fas fa-mobile-alt"></i>
                                        <span class="twm-title">Téléphone</span>
                                        <div class="twm-s-info-discription">{{job.society.telephone}}</div>
                                    </div>
                                </li>
                                <li>
                                    <div class="twm-s-info-inner">
                                        <i class="fas fa-at"></i>
                                        <span class="twm-title">Email</span>
                                        <div class="twm-s-info-discription">thewebmaxdemo@gmail.com</div>
                                    </div>
                                </li>
                                <li>
                                    <div class="twm-s-info-inner">
                                        <i class="fas fa-desktop"></i>
                                        <span class="twm-title">Website</span>
                                        <div class="twm-s-info-discription">{{job.society.website}}</div>
                                    </div>
                                </li>
                                <li>
                                    <div class="twm-s-info-inner">
                                        <i class="fas fa-map-marker-alt"></i>
                                        <span class="twm-title">Localisation</span>
                                        <div class="twm-s-info-discription">{{job.location}}</div>
                                    </div>
                                </li>

                            </ul>
                            <a href="#" class=" site-button">Voir toutes ses offres</a>

                        </div>
                    </div>
                    <div class="twm-advertisment" style="background-image:url(images/add-bg.jpg);">
                        <div class="overlay"></div>
                        <h4 class="twm-title">Recruteurs ?</h4>
                        <p>Get Best Matched Jobs On your <br>
                            Email. Add Resume NOW!</p>
                        <a href="javascript:;" class="site-button white">Read More</a>
                    </div>


                </div>

            </div>

        </div>

    </div>

</div>
<!-- OUR BLOG END -->



{% if not candidature_bool %}

<div class="modal fade" id="apply_job_popup" aria-hidden="true" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="sign_up_popupLabel">Postuler à cette offre</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <div class="apl-job-inpopup">
                    <!--Basic Information-->
                    <div class="panel panel-default">

                        <div class="panel-body wt-panel-body p-a20 ">

                            <div class="twm-tabs-style-1">
                                {{ form_start(form) }}
                                <div class="row">
                                    <div class="col-xl-12 col-lg-12 col-md-12">
                                        <div class="form-group">
                                            <label>Disponibilité</label>
                                            <div class="ls-inputicon-box">

                                                {{ form_widget(form.availabilityDate, {'attr': {'class': 'form-control', 'placeholder': ""}}) }}
                                                <i class="fs-input-icon fa fa-user "></i>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-12">
                                        <div class="form-group">
                                            <label>Lettre de motivation</label>
                                            {{ form_widget(form.motivation, {'attr': {'class': 'form-control', 'placeholder': ""}}) }}
                                        </div>
                                    </div>

                                    <div class="col-xl-12 col-lg-12 col-md-12">
                                        <div class="text-left">
                                            {{ form_widget(form.submit, {'attr': {'class': 'site-button'}}) }}
                                        </div>
                                    </div>
                                </div>
                                {{ form_end(form) }}
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
{% endif %}

{% endblock %}