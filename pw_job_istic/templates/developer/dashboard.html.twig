{% extends 'template.html.twig' %}

{% block title %}Hello DeveloperController!{% endblock %}

{% block body %}

<!-- OUR BLOG START -->
<br/><br/><div class="section-full p-t120  p-b90 site-bg-white">


    <div class="container">
    
        <div class="row">

            <div class="col-xl-3 col-lg-4 col-md-12 rightSidebar m-b30">

                {{include('includes/sidebars/developer.html.twig', { active: active_tab }) }} 

            </div>

            <div class="col-xl-9 col-lg-8 col-md-12 m-b30">
                <!--Filter Short By-->
                <div class="twm-right-section-panel site-bg-gray">
                    <div class="wt-admin-right-page-header">
                        <h5>Bienvenue, {{ app.user.developer.lastname }} </h5>
                    </div>

                    <div class="twm-dash-b-blocks mb-5">
                        <div class="row">
                            <div class="col-xl-4 col-lg-4 col-md-12 mb-3">
                                <div class="panel panel-default">
                                    <div class="panel-body wt-panel-body dashboard-card-2 block-gradient">
                                        <div class="wt-card-wrap-2">
                                            <div class="wt-card-icon-2"><i class="flaticon-job"></i></div>
                                            <div class="wt-card-right wt-total-active-listing counter ">
                                           {{nbre_candidature}}                                      
                                            </div>
                                            <div class="wt-card-bottom-2 ">
                                                <h4 class="m-b0">Candidature envoy°</h4>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                             <div class="col-xl-4 col-lg-4 col-md-12 mb-3">
                                <div class="panel panel-default">
                                    <div class="panel-body wt-panel-body dashboard-card-2 block-gradient-2">
                                        <div class="wt-card-wrap-2">
                                            <div class="wt-card-icon-2"><i class="fa fa-eye"></i></div>
                                            <div class="wt-card-right wt-total-listing-review counter ">{{ app.user.developer.getViewsCount() }}</div>
                                            <div class="wt-card-bottom-2">
                                                <h4 class="m-b0">Vue de profil</h4>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xl-4 col-lg-4 col-md-12 mb-3">
                                <div class="panel panel-default">
                                    <div class="panel-body wt-panel-body dashboard-card-2 block-gradient-3">
                                        <div class="wt-card-wrap-2">
                                            <div class="wt-card-icon-2"><i class="fa fa-star"></i></div>
                                            <div class="wt-card-right wt-total-listing-review counter ">{{ ma_note }}</div>
                                            <div class="wt-card-bottom-2">
                                                <h4 class="m-b0">Note obtenue</h4>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="twm-pro-view-chart-wrap">
                        <div class="row"> <div class="col-lg-12 col-md-12 mb-4">
                                <div class="panel panel-default">
                                    <div class="panel-heading wt-panel-heading p-a20">
                                        <h4 class="panel-tittle m-a0">Postes les plus populaires</h4>
                                    </div>
                                    <div class="panel-body wt-panel-body bg-white">
                                        <div class="twm-jobs-list-wrap">
                                            <ul>
                                                {% for job in popular_jobs %}
                                                <li>
                                                    <div class="twm-jobs-list-style1 mb-5">
                                                        <div class="twm-media">
                                                            <img src="{{ asset('uploads/avatars/' ~ job.image) }}" alt="#">
                                                        </div>
                                                        <div class="twm-mid-content">
                                                            
                                                            <a href="job-detail.html" class="twm-job-title">
                                                                <h4> {{ job.title}} <span class="twm-job-post-duration">  {{ job.publishedAt|date('d/m/Y') }}</span></h4>
                                                            </a>
                                                            <p class="twm-job-address">{{ job.location }}</p>
                                                            <a href="https://themeforest.net/user/thewebmax/portfolio" class="twm-job-websites site-text-primary">{{ job.society.website}}</a>
                                                            <p style="margin-top:5px" class="twm-candidate-address">Vu par <i class="fa fa-eye"></i>{{ job.getViewsCount() }}</p>
                                                            
                                                        </div>
                                                        <div class="twm-right-content">
                                                            <div class="twm-jobs-category green"><span class="twm-bg-green">Populaire</span></div>
                                                            <div class="twm-jobs-amount">${{ job.salary}} <span> /Mois </span></div>
                                                            <a href="{{path('dev_job_details',{id:job.id})}}" class="twm-jobs-browse site-text-primary">Postuler</a>
                                                        </div>
                                                    </div>
                                                </li>
                                                {% endfor %}
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row" >
                            <div class="col-lg-12 col-md-12 mb-4">
                                <div class="panel panel-default">
                                    <div class="panel-heading wt-panel-heading p-a20">
                                        <h4 class="panel-tittle m-a0">3 dernières offres publiées.</h4>
                                    </div>
                                    <div class="panel-body wt-panel-body bg-white">
                                        
                                        <div class="twm-jobs-list-wrap">
                                            <ul>
                                                {% for job in last_jobs %}
                                                <li>
                                                    <div class="twm-jobs-list-style1 mb-5">
                                                        <div class="twm-media">
                                                            <img src="{{ asset('uploads/avatars/' ~ job.image) }}" alt="#">
                                                        </div>
                                                        <div class="twm-mid-content">
                                                            <a href="job-detail.html" class="twm-job-title">
                                                                <h4> {{ job.title}} <span class="twm-job-post-duration"> {{ job.publishedAt|date('d/m/Y') }}</span></h4>
                                                            </a>
                                                            <p class="twm-job-address"> {{ job.location }} </p>
                                                            <a href="https://themeforest.net/user/thewebmax/portfolio" class="twm-job-websites site-text-primary">{{ job.society.website}}</a>
                                                             <p style="margin-top:5px" class="twm-candidate-address">Vu par <i class="fa fa-eye"></i>{{ job.getViewsCount() }}</p>
                                                        </div>
                                                        <div class="twm-right-content">
                                                            <div class="twm-jobs-category green"><span class="twm-bg-green">New</span></div>
                                                            <div class="twm-jobs-amount">${{ job.salary}} <span> /Mois</span></div>
                                                            <a href="{{path('dev_job_details',{id:job.id})}}" class="twm-jobs-browse site-text-primary">Postuler</a>
                                                        </div>
                                                    </div>
                                                </li>
                                                {% endfor %}
                                            </ul>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>
<!-- OUR BLOG END -->
{% endblock %}