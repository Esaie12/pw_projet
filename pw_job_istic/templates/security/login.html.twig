{% extends 'base.html.twig' %}

{% block title %}Log in!{% endblock %}

{% block body %}
<div class="row">
    <div class="col-xl-8 col-lg-6 col-md-5 twm-log-reg-media-wrap">
        <div class="twm-log-reg-media">
            <div class="twm-l-media">
                <img src="images/login-bg.png" alt="">
            </div>
        </div>
    </div>
    <div class="col-xl-4 col-lg-6 col-md-7">
        <div class="twm-log-reg-form-wrap">
            <div class="twm-log-reg-logo-head">
                <a href="{{path('app_user_index')}}">
                    <img src="images/logo-dark.png" alt="" class="logo">
                </a>
            </div>

            <div class="twm-log-reg-inner">
                <div class="twm-log-reg-head">
                    <div class="twm-log-reg-logo">
                        <span class="log-reg-form-title">Se connecter</span>
                    </div>
                </div>
                <div class="twm-tabs-style-2">

                    {% for type, messages in app.flashes %}
                        <div class="alert alert-{{ type }}">
                            {% for message in messages %}
                                {{ message }}
                            {% endfor %}
                        </div>
                    {% endfor %}
                     {% for type, messages in app.flashes %}
                                {% for message in messages %}
                                    toastr.{{ type }}("{{ message|e('js') }}");
                                {% endfor %}
                            {% endfor %}

                    <form class="tab-content" id="" method="POST" >
                        <input type="hidden" name="_csrf_token"  value="{{ csrf_token('authenticate') }}">
                        
                        <!--Login Candidate Content-->
                        <div class="tab-pane fade show active" id="twm-login-candidate">
                            <div class="row">
                                <div class="col-lg-12" >
                                    {% if error %}
                                        <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                                    {% endif %}

                                    {% if app.user %}
                                        <div class="mb-3">
                                            Connecté en tant que {{ app.user.userIdentifier }}, <a href="{{ path('app_logout') }}">Deconnexion</a>
                                        </div>
                                    {% endif %}
                                </div>
                                <div class="col-lg-12">
                                    <div class="form-group mb-3">
                                        <input name="email" type="email" value="" required="" class="form-control"
                                            placeholder="Mail*">
                                    </div>
                                </div>

                                <div class="col-lg-12">
                                    <div class="form-group mb-3">
                                        <input  name="password" type="password" class="form-control" required=""
                                            placeholder="Password*">
                                    </div>
                                </div>

                                <div class="col-lg-12">
                                    <div class="twm-forgot-wrap">
                                        <div class="form-group mb-3">
                                            <div class="form-check">
                                                <input type="checkbox" class="form-check-input" id="Password4">
                                                <label class="form-check-label rem-forgot" for="Password4">Se souvenir de moi
                                                <a href="javascript:;" class="site-text-primary">Mot de passe oublié</a></label>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-12">
                                    <div class="form-group">
                                        <button type="submit" class="site-button">Se connecter</button>
                                    </div>
                                </div>

                               <div class="col-md-12 text-center">
                                    <div class="form-group">
                                        <a href="{{path('app_user_new')}}" class="site-text-primary">S'inscrire</a>
                                    </div>
                                </div>
                               
                            </div>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}